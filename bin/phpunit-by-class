#!/usr/bin/env php
<?php

declare(strict_types=1);

$projectRoot = dirname(__DIR__);
$phpunit = $projectRoot . '/vendor/phpunit/phpunit/phpunit';
$configuration = $projectRoot . '/phpunit.xml';
$testRoot = $projectRoot . '/src/Modules';

if (! is_file($phpunit)) {
    fwrite(STDERR, "PHPUnit was not found. Run composer install first.\n");
    exit(1);
}

$forwardedArgs = array_slice($_SERVER['argv'], 1);

if (shouldUsePhpUnitDirectly($forwardedArgs)) {
    exit(runPhpUnit($phpunit, $forwardedArgs));
}

$testFiles = discoverTestFiles($testRoot);

if ($testFiles === []) {
    fwrite(STDERR, "No test classes were found under src/Modules.\n");
    exit(1);
}

$baseArgs = hasConfigurationOption($forwardedArgs)
    ? $forwardedArgs
    : array_merge(['--configuration', $configuration], $forwardedArgs);

$failed = [];
$total = count($testFiles);
$start = microtime(true);
$stopOnDefect = hasStopOnDefectOption($forwardedArgs);

printf("Running %d test classes one by one\n\n", $total);

foreach ($testFiles as $index => $testFile) {
    $relativePath = relativePath($projectRoot, $testFile);

    printf("[%d/%d] %s\n", $index + 1, $total, $relativePath);

    $exitCode = runPhpUnit($phpunit, array_merge($baseArgs, [$testFile]));

    if ($exitCode !== 0) {
        $failed[$relativePath] = $exitCode;

        if ($stopOnDefect) {
            break;
        }
    }

    echo "\n";
}

$duration = microtime(true) - $start;

if ($failed !== []) {
    fwrite(STDERR, sprintf(
        "Failed %d of %d test classes in %.2fs:\n",
        count($failed),
        $total,
        $duration
    ));

    foreach ($failed as $path => $exitCode) {
        fwrite(STDERR, sprintf(" - %s (exit %d)\n", $path, $exitCode));
    }

    exit(1);
}

printf("All %d test classes passed in %.2fs\n", $total, $duration);

function discoverTestFiles(string $testRoot): array
{
    if (! is_dir($testRoot)) {
        return [];
    }

    $files = [];
    $iterator = new RecursiveIteratorIterator(
        new RecursiveDirectoryIterator($testRoot, FilesystemIterator::SKIP_DOTS)
    );

    foreach ($iterator as $file) {
        if (! $file instanceof SplFileInfo || ! $file->isFile()) {
            continue;
        }

        $path = $file->getPathname();

        if (str_ends_with($path, 'Test.php') && str_contains($path, DIRECTORY_SEPARATOR . 'Tests' . DIRECTORY_SEPARATOR)) {
            $files[] = $path;
        }
    }

    sort($files, SORT_STRING);

    return $files;
}

function runPhpUnit(string $phpunit, array $arguments): int
{
    $command = array_merge([PHP_BINARY, $phpunit], $arguments);
    $process = proc_open($command, [
        0 => STDIN,
        1 => STDOUT,
        2 => STDERR,
    ], $pipes);

    if (! is_resource($process)) {
        fwrite(STDERR, "Unable to start PHPUnit.\n");

        return 1;
    }

    return proc_close($process);
}

function shouldUsePhpUnitDirectly(array $arguments): bool
{
    $directOptions = [
        '--filter',
        '--testsuite',
        '--exclude-testsuite',
        '--group',
        '--exclude-group',
        '--covers',
        '--uses',
        '--list-suites',
        '--list-groups',
        '--list-tests',
        '--list-tests-xml',
        '--generate-configuration',
        '--migrate-configuration',
        '--version',
        '--atleast-version',
        '--check-version',
        '--check-php-configuration',
        '-h',
        '--help',
    ];

    foreach ($arguments as $argument) {
        if ($argument === '--') {
            return true;
        }

        if ($argument === '') {
            continue;
        }

        if ($argument[0] !== '-') {
            return true;
        }

        foreach ($directOptions as $option) {
            if ($argument === $option || str_starts_with($argument, $option . '=')) {
                return true;
            }
        }
    }

    return false;
}

function hasConfigurationOption(array $arguments): bool
{
    foreach ($arguments as $argument) {
        if ($argument === '-c' || $argument === '--configuration' || str_starts_with($argument, '--configuration=')) {
            return true;
        }
    }

    return false;
}

function hasStopOnDefectOption(array $arguments): bool
{
    $stopOptions = [
        '--stop-on-defect',
        '--stop-on-error',
        '--stop-on-failure',
        '--stop-on-warning',
        '--stop-on-risky',
        '--stop-on-deprecation',
        '--stop-on-notice',
        '--stop-on-skipped',
        '--stop-on-incomplete',
    ];

    return count(array_intersect($arguments, $stopOptions)) > 0;
}

function relativePath(string $root, string $path): string
{
    $prefix = rtrim($root, DIRECTORY_SEPARATOR) . DIRECTORY_SEPARATOR;

    if (str_starts_with($path, $prefix)) {
        return substr($path, strlen($prefix));
    }

    return $path;
}
