{
  "name": "pacttrack/shared-resources",
  "description": "Shared Laravel module with modular support for PactTrack (User, Clients, Documents, Signatures, etc.).",
  "type": "library",
  "version": "1.0.0",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "PactTrackSDK\\SharedResources\\": "src/",
       "PactTrackSDK\\SharedResources\\TestCase\\": "src/TestCase/"
    }
  },
  "scripts": {
    "test": "@php bin/phpunit-by-class"
  },
  "extra": {
    "laravel": {
      "providers": [
        "PactTrackSDK\\SharedResources\\SharedResourceServiceProvider"
      ]
    }
  },
  "require": {
    "php": "^8.1",
    "laravel/sanctum": "^4.0",
    "spatie/laravel-permission": "^8.3"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0",
    "orchestra/testbench": "^11.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
